# Dev tooling and caches; model files live in ~/models, secrets in ../<project>-secrets/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.DS_Store
# Inbox items can be private or real data: keep everything but the README out of git
inbox/*
!inbox/README.md
# Rebuildable products of the example video stay out of git
examples/videos/*/work/
examples/videos/*/out/
