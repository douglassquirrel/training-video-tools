#!/usr/bin/env python3
"""check-video: the same checks on every finished video."""

import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))

# The commands' packages live in the repository's own .venv (README, Installation): if it is
# there and this is not it, run again under it, whatever python3 the shell found.
VENV = os.path.join(HERE, ".venv", "bin", "python")
UNDER_VENV = (os.path.realpath(sys.prefix) == os.path.realpath(os.path.join(HERE, ".venv"))
              or os.environ.get("VIDEO_TOOLS_VENV") == VENV)
if os.path.isfile(VENV) and not UNDER_VENV:
    os.environ["VIDEO_TOOLS_VENV"] = VENV
    os.execv(VENV, [VENV, os.path.realpath(__file__)] + sys.argv[1:])

# Never write __pycache__ into a video's folder or anywhere else.
sys.dont_write_bytecode = True
os.environ["PYTHONDONTWRITEBYTECODE"] = "1"
sys.path.insert(0, HERE)

from videotools.check_video import main  # noqa: E402

sys.exit(main())
