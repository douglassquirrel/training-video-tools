{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/projects/code/lobster-tools-code/lobster-tools/lobster-mail\" start --project \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(~/projects/code/lobster-tools-code/lobster-tools/lobster-mail:*)"
    ]
  }
}
